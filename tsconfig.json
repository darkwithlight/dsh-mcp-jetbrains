{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "strict": false,
    "rootDir": "src",
    "declaration": false,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "types": ["node"]
  }
}
